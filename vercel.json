{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "p22-digital-card.vercel.app"
        }
      ],
      "destination": "https://card.p22corp.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/badge/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/badge-:rep/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/setup", "destination": "/setup.html" },
    { "source": "/badge/pedro", "destination": "/badge-pedro" },
    { "source": "/badge/eduardo", "destination": "/badge-eduardo" },
    { "source": "/badge/marleni", "destination": "/badge-marleni" },
    { "source": "/badge/bids", "destination": "/badge-bids" },
    { "source": "/badge/logistics", "destination": "/badge-logistics" },
    { "source": "/badge", "destination": "/badge-pedro" },
    { "source": "/badge/:rep", "destination": "/badge-:rep" },
    { "source": "/staff", "destination": "/badge-pedro" },
    { "source": "/capability-statement", "destination": "/capability-statement.html" },
    { "source": "/pedro", "destination": "/pedro.html" },
    { "source": "/eduardo", "destination": "/eduardo.html" },
    { "source": "/marleni", "destination": "/marleni.html" },
    { "source": "/bids", "destination": "/bids.html" },
    { "source": "/logistics", "destination": "/logistics.html" },
    { "source": "/r/:rep", "destination": "/api/router?rep=:rep" },
    { "source": "/rep/:slug", "destination": "/index" }
  ],
  "headers": [
    {
      "source": "/(.*\\.vcf)",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/assets/vcf/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*\\.pkpass)",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.apple.pkpass" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/assets/passes/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.apple.pkpass" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*\\.ics)",
      "headers": [
        { "key": "Content-Type", "value": "text/calendar; charset=utf-8" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" },
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*\\.mp4)",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
