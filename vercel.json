{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/setup", "destination": "/setup.html" },
    { "source": "/capability-statement", "destination": "/capability-statement.html" },
    { "source": "/pedro", "destination": "/index.html" },
    { "source": "/eduardo", "destination": "/index.html" },
    { "source": "/marleni", "destination": "/index.html" },
    { "source": "/bids", "destination": "/index.html" },
    { "source": "/logistics", "destination": "/index.html" },
    { "source": "/rep/:slug", "destination": "/index.html" },
    { "source": "/((?!assets|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
